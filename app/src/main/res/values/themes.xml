<resources xmlns:tools="http://schemas.android.com/tools">
    <!-- Base application theme -->
    <style name="Theme.HardtekkElectribe" parent="Theme.Material3.DayNight.NoActionBar">
        <!-- Primary brand color -->
        <item name="colorPrimary">@color/neon_pink</item>
        <item name="colorPrimaryVariant">@color/neon_pink_dim</item>
        <item name="colorOnPrimary">@color/text_on_pink</item>

        <!-- Secondary brand color -->
        <item name="colorSecondary">@color/magenta</item>
        <item name="colorSecondaryVariant">@color/magenta_dim</item>
        <item name="colorOnSecondary">@color/text_on_pink</item>

        <!-- Background colors -->
        <item name="android:colorBackground">@color/anthracite</item>
        <item name="colorSurface">@color/anthracite_card</item>
        <item name="colorOnBackground">@color/text_on_dark</item>
        <item name="colorOnSurface">@color/text_on_dark</item>

        <!-- Error -->
        <item name="colorError">@color/led_red</item>
        <item name="colorOnError">@color/text_on_pink</item>

        <!-- Status bar -->
        <item name="android:statusBarColor">@color/anthracite</item>
        <item name="android:navigationBarColor">@color/anthracite</item>
        <item name="android:windowLightStatusBar">false</item>
        <item name="android:windowLightNavigationBar">false</item>

        <!-- Window -->
        <item name="android:windowBackground">@color/anthracite</item>
        <item name="android:windowContentOverlay">@null</item>
        <item name="android:windowNoTitle">true</item>
        <item name="android:windowFullscreen">true</item>

        <!-- Typography -->
        <item name="android:textColorPrimary">@color/text_primary</item>
        <item name="android:textColorSecondary">@color/text_secondary</item>
    </style>

    <!-- No ActionBar variant for fullscreen -->
    <style name="Theme.HardtekkElectribe.NoActionBar" parent="Theme.HardtekkElectribe">
        <item name="windowActionBar">false</item>
        <item name="windowNoTitle">true</item>
        <item name="android:windowFullscreen">true</item>
        <item name="android:windowContentOverlay">@null</item>
    </style>

    <!-- Splash screen theme -->
    <style name="Theme.HardtekkElectribe.Splash" parent="Theme.HardtekkElectribe">
        <item name="android:windowBackground">@drawable/splash_background</item>
        <item name="android:windowFullscreen">true</item>
    </style>

    <!-- Dialog theme -->
    <style name="Theme.HardtekkElectribe.Dialog" parent="Theme.Material3.DayNight.Dialog">
        <item name="colorPrimary">@color/neon_pink</item>
        <item name="colorPrimaryVariant">@color/neon_pink_dim</item>
        <item name="colorOnPrimary">@color/text_on_pink</item>
        <item name="colorSurface">@color/anthracite_card</item>
        <item name="colorOnSurface">@color/text_on_dark</item>
        <item name="android:windowBackground">@color/anthracite_card</item>
        <item name="android:windowMinWidthMajor">90%</item>
        <item name="android:windowMinWidthMinor">90%</item>
    </style>

    <!-- Custom button styles -->
    <style name="Widget.HardtekkElectribe.TransportButton" parent="Widget.Material3.Button.ElevatedButton">
        <item name="android:minWidth">64dp</item>
        <item name="android:minHeight">48dp</item>
        <item name="cornerRadius">8dp</item>
        <item name="android:textSize">12sp</item>
        <item name="android:textStyle">bold</item>
        <item name="android:textAllCaps">true</item>
        <item name="android:letterSpacing">0.1</item>
    </style>

    <style name="Widget.HardtekkElectribe.PatternButton" parent="Widget.Material3.Button.OutlinedButton">
        <item name="android:minWidth">48dp</item>
        <item name="android:minHeight">48dp</item>
        <item name="cornerRadius">6dp</item>
        <item name="android:textSize">14sp</item>
        <item name="android:textStyle">bold</item>
        <item name="strokeColor">@color/neon_pink</item>
        <item name="strokeWidth">2dp</item>
    </style>

    <style name="Widget.HardtekkElectribe.ModeButton" parent="Widget.Material3.Button.ToggleButton">
        <item name="android:minWidth">80dp</item>
        <item name="android:minHeight">36dp</item>
        <item name="cornerRadius">6dp</item>
        <item name="android:textSize">11sp</item>
        <item name="android:textStyle">bold</item>
        <item name="android:textAllCaps">true</item>
    </style>

    <!-- Knob style -->
    <style name="Widget.HardtekkElectribe.RotaryKnob">
        <item name="android:minWidth">64dp</item>
        <item name="android:minHeight">64dp</item>
    </style>

    <!-- Pad style -->
    <style name="Widget.HardtekkElectribe.TriggerPad">
        <item name="android:minWidth">48dp</item>
        <item name="android:minHeight">48dp</item>
    </style>
</resources>